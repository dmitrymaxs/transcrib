{
  "name": "transcrib-electron",
  "version": "1.0.0",
  "description": "Transcrib - Audio Transcription App with Timestamps",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/setup-dll-dependencies.js && electron .",
    "install-runtime": "start install-vc-runtime.bat",
    "icons": "node scripts/generate-icon.js",
    "prebuild-check": "node scripts/prebuild-check.js",
    "diagnose-whisper": "node scripts/diagnose-whisper.js",
    "setup-dll": "node scripts/setup-dll-dependencies.js",
    "setup-models": "node scripts/setup-embedded-models.js",
    "prebuild": "npm run prebuild-check && npm run setup-dll && npm run setup-models",
    "build": "npm run prebuild && electron-builder",
    "activation-code": "node scripts/generate-activation-code.js"
  },
  "author": "Dmitry Maksimov",
  "license": "BUSL-1.1",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "whisper-cpp-node": "^0.2.12",
    "whisper-node": "^1.1.1"
  },
  "build": {
    "appId": "com.transcrib.app",
    "productName": "Transcrib",
    "icon": "transcrib-icon.ico",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "transcrib-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "scripts/**/*",
      "resources/**/*",
      "node_modules/**/*",
      "transcrib-icon.ico",
      "transcrib-icon-256.png",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": ["**/*"]
      },
	  
	  {
        "from": "./resources/main.py",
         "to": "main.py"
	  },
	  
      {
        "from": "node_modules/whisper-node/lib/whisper.cpp",
        "to": "whisper.cpp",
        "filter": ["!models/*"]
      }
    ]
  }
}
